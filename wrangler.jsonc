{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "generator-kursi-v2",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD_DO",
        "class_name": "LeaderboardDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["LeaderboardDO"]
    }
  ],
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD_KV",
      "id": "0ee4fb854bc7423f9a8d8f037e47e115"
    }
  ]
}