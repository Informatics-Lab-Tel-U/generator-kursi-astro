# Secret server-side API Key for Astro SSR Proxy -> Backend Hono
INTERNAL_API_KEY=your-internal-api-key-here

# Target Backend Hono URL (Server SSR & Client Heartbeat)
# Gunakan http://localhost:8787 untuk backend lokal, atau URL worker Anda saat deployment
PRAKTIKAN_API_URL=http://localhost:8787
PUBLIC_PRAKTIKAN_API_URL=http://localhost:8787

# Allowed Origins (CORS)
PRAKTIKAN_GET_ALLOWED_ORIGINS=http://localhost:4321,https://your-domain.example.com
