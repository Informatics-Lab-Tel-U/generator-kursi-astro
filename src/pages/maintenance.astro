---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="maintenance-page">
    <!-- Theme Toggle Button -->
    <button
      id="theme-toggle"
      class="theme-toggle"
      aria-label="Ganti tema"
      title="Ganti Tema"
    >
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2"></path>
        <path d="M12 20v2"></path>
        <path d="m4.93 4.93 1.41 1.41"></path>
        <path d="m17.66 17.66 1.41 1.41"></path>
        <path d="M2 12h2"></path>
        <path d="M20 12h2"></path>
        <path d="m6.34 17.66-1.41-1.41"></path>
        <path d="m19.07 4.93-1.41 1.41"></path>
      </svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
      </svg>
    </button>

    <!-- Main Stitch Clean Card -->
    <div class="stitch-card">
      <div class="icon-clean">
        <!-- Lucide Wrench Icon -->
        <svg xmlns="http://www.w3.org/2000/svg" width="42" height="42" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
        </svg>
      </div>

      <h1 class="main-title">Generator Kursi Praktikum</h1>

      <p class="description">Sedang dalam pemeliharaan.</p>


      <div class="footer-copy">
        Informatics Lab Telkom University &copy; {new Date().getFullYear()}
      </div>
    </div>
  </div>

  <script is:inline>
    const toggleBtn = document.getElementById('theme-toggle');
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme') || 'dark';
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('kursi-theme', next);
      });
    }
  </script>
</Layout>

<style>
  .maintenance-page {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: 24px;
    background: var(--bg-page);
    color: var(--text-primary);
    font-family: 'Google Sans', 'Poppins', sans-serif;
    transition: background var(--transition-normal), color var(--transition-normal);
  }

  /* Theme Toggle Button matching landing page specifications */
  .theme-toggle {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--bg-hover);
    border: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    transition: all var(--transition-fast);
    z-index: 20;
  }

  .theme-toggle:hover {
    background: var(--bg-active);
    transform: scale(1.05);
  }

  .theme-toggle:active {
    transform: scale(0.95);
  }

  /* Theme icon display logic */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: none;
  }
  :global([data-theme="dark"]) .icon-sun {
    display: inline-block;
  }
  :global([data-theme="light"]) .icon-moon,
  :global(:root:not([data-theme="dark"])) .icon-moon {
    display: inline-block;
  }

  /* Clean minimal card aligned with KursiGenerator.css tokens */
  .stitch-card {
    max-width: 480px;
    width: 100%;
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    -webkit-backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 32px 28px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    transition: all var(--transition-normal);
  }

  .icon-clean {
    color: var(--text-muted);
    opacity: 0.7;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }


  /* Title strictly matching .main-title (22px bold) */
  .main-title {
    font-family: "Google Sans", "Poppins", sans-serif;
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0;
    line-height: 1.3;
  }

  .description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }


  .footer-copy {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-muted);
    opacity: 0.7;
    margin-top: 8px;
  }

  @media (max-width: 600px) {
    .stitch-card {
      padding: 24px 20px;
    }
    .theme-toggle {
      top: 16px;
      right: 16px;
    }
  }
</style>
